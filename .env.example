# Environment Configuration Template
# Copy this file to .env and customize with your own values

# Test Environment
TEST_ENV=dev
BASE_URL=https://www.shufersal.co.il/online/he

# Browser Settings (optional overrides)
HEADLESS=true
SLOW_MO=500
BROWSER_TIMEOUT=30000

# Reporting
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=false

# Delivery Address Configuration
# These values are used when the address modal appears (first time adding to cart)
# Example: Tel Aviv address - replace with your own
DELIVERY_CITY=תל אביב
DELIVERY_STREET=דיזנגוף
DELIVERY_STREET_NUMBER=1
DELIVERY_APARTMENT=1

# Delivery Time Slot Configuration
# Date format: YYYYMMDD (e.g., 20251106 for November 6, 2025)
# Time format: HH:MM (24-hour format, e.g., 18:00)
# Update to a future date when running tests
DELIVERY_DATE=20251106
DELIVERY_TIME=13:00
